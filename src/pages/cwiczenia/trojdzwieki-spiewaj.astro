---
import Layout from '../../layouts/Layout.astro';
import SubNav from '../../components/SubNav.astro';
---
<Layout
  title="Zaśpiewaj trójdźwięk - ksza.pl"
  description="Ćwiczenie solfeżowe: posłuchaj dźwięku wyjściowego, zaśpiewaj składniki trójdźwięku i sprawdź się z fortepianem."
  currentFamily="Trójdźwięki"
  creditType="both"
  includeWidgetsCss={true}
>
  <main>
    <div class="container exercise-page">
      <div class="widget">
        <SubNav group="trojdzwieki" />
        <div class="widget-header">
          <h1>Zaśpiewaj trójdźwięk</h1>
          <p>Posłuchaj dźwięku wyjściowego, zaśpiewaj kolejne składniki akordu, a potem sprawdź się z fortepianem.</p>
        </div>

        <div class="controls-row">
          <div class="field">
            <label for="level-select">Poziom</label>
            <div class="select-wrap">
              <select id="level-select">
                <option value="1">Postać zasadnicza – dźwięki naturalne</option>
                <option value="2">Zasadnicza + przewroty – z chromatycznymi</option>
              </select>
            </div>
          </div>
          <div class="field">
            <label for="clef-select">Klucz</label>
            <div class="select-wrap">
              <select id="clef-select">
                <option value="random">Losowo</option>
                <option value="treble">Wiolinowy</option>
                <option value="bass">Basowy</option>
              </select>
            </div>
          </div>
        </div>

        <div class="sing-task-card" aria-live="polite">
          <div class="sing-task-badge" id="task-badge">+</div>
          <div class="sing-task-body">
            <div class="sing-task-meta">
              <span id="task-inversion-tag" class="sing-tag tag-direction-up">Postać zasadnicza</span>
              <span id="task-root-tag" class="sing-tag tag-root">od: <strong>C4</strong></span>
            </div>
            <div class="sing-task-title" id="task-title">
              Zaśpiewaj: <strong>Trójdźwięk durowy</strong>
            </div>
          </div>
        </div>

        <div id="status-line" class="status-line"></div>

        <div class="player-controls">
          <button type="button" id="ref-pitch-btn" class="btn-ghost">
            <span>Dźwięk wyjściowy</span>
          </button>
          <button type="button" id="play-model-btn" class="btn-primary">
            <span class="play-icon" aria-hidden="true"></span>
            <span id="play-model-text">Sprawdź z fortepianem</span>
          </button>
          <button type="button" id="next-btn" class="btn-dark">
            <span>Następny trójdźwięk →</span>
          </button>
        </div>

        <div class="notation-wrap">
          <div id="notation-container" class="notation-container" aria-live="polite"></div>
        </div>

        <div id="feedback" class="feedback-msg" aria-live="polite" role="status"></div>
      </div>
    </div>
  </main>

  <Fragment slot="scripts">
    <script is:inline src="/assets/vendor/smplr.js"></script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/verovio@6.3.0/dist/verovio-toolkit-wasm.js"></script>
    <script is:inline src="/assets/js/core.js"></script>
    <script is:inline src="/assets/js/music-theory.js"></script>
    <script is:inline src="/assets/js/verovio-render.js"></script>
    <script is:inline src="/assets/js/trojdzwieki-spiewaj.js"></script>
  </Fragment>
</Layout>
