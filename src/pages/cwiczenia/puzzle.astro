---
import Layout from '../../layouts/Layout.astro';
import SubNav from '../../components/SubNav.astro';

const subNavItems = [
  { label: 'Ze słuchu', href: '/cwiczenia/puzzle', active: true },
  { label: 'Zapis nutowy', href: '/cwiczenia/puzzle-zapis' },
];
---
<Layout
  title="Dyktando muzyczne - puzzle - ksza.pl"
  description="Ćwiczenie: układanie potasowanych taktów dyktanda melodycznego we właściwej kolejności ze słuchu."
  currentFamily="Puzzle"
  creditType="smplr"
  includeWidgetsCss={true}
>
  <main>
    <div class="container exercise-page">
      <div class="widget">
        <SubNav items={subNavItems} />
        <div class="widget-header">
          <h1>Dyktando muzyczne - puzzle</h1>
          <p>Wysłuchaj dyktanda, a następnie ułóż potasowane fragmenty (takty) we właściwej kolejności.</p>
        </div>

        <ul class="staff" aria-hidden="true"><li></li><li></li><li></li><li></li><li></li></ul>

        <div class="controls-row">
          <div class="field">
            <label for="klasa-select">Klasa</label>
            <div class="select-wrap">
              <select id="klasa-select"></select>
            </div>
          </div>
          <div class="field">
            <label for="dictation-select">Dyktando</label>
            <div class="select-wrap">
              <select id="dictation-select"></select>
            </div>
          </div>
          <div class="field">
            <label for="instrument-select">Instrument</label>
            <div class="select-wrap">
              <select id="instrument-select">
                <option value="piano">Fortepian</option>
                <option value="flute">Flet</option>
                <option value="clarinet">Klarnet</option>
                <option value="violin">Skrzypce</option>
                <option value="xylophone">Ksylofon</option>
                <option value="trumpet">Trąbka</option>
                <option value="bassoon">Fagot</option>
              </select>
            </div>
          </div>
          <div class="field tempo-field">
            <label for="tempo-slider">Tempo <span id="tempo-value">100%</span></label>
            <input type="range" id="tempo-slider" min="50" max="150" step="5" value="100">
          </div>
        </div>

        <div id="status-line" class="status-line"></div>

        <div class="player-controls">
          <button id="play-full-btn" class="btn-primary">
            <span class="play-icon" aria-hidden="true"></span>
            <span>Odtwórz całe dyktando</span>
          </button>
          <button id="pause-btn" class="btn-primary" style="display:none;">
            <span class="pause-icon" aria-hidden="true"></span>
            <span>Pauza</span>
          </button>
          <button id="resume-btn" class="btn-primary" style="display:none;">
            <span class="play-icon" aria-hidden="true"></span>
            <span>Wznów</span>
          </button>
          <button id="restart-btn" class="btn-ghost" style="display:none;">Od początku</button>
        </div>

        <ul id="puzzle-list" class="puzzle-list"></ul>

        <div class="puzzle-controls">
          <button id="shuffle-btn" class="btn-ghost">Przetasuj ponownie</button>
          <button id="listen-arrangement-btn" class="btn-ghost">Odsłuchaj mój układ</button>
          <button id="check-btn" class="btn-dark">Sprawdź kolejność</button>
        </div>

        <div id="result-feedback" class="feedback-msg"></div>
      </div>
    </div>
  </main>

  <Fragment slot="scripts">
    <script is:inline src="/assets/vendor/smplr.js"></script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.7/Sortable.min.js"></script>
    <script is:inline src="/assets/js/core.js"></script>
    <script is:inline src="/assets/js/klasa-filter.js"></script>
    <script is:inline src="/assets/js/puzzle-engine.js"></script>
    <script is:inline src="/assets/js/puzzle.js"></script>
  </Fragment>
</Layout>
