---
import Layout from '../../layouts/Layout.astro';
import SubNav from '../../components/SubNav.astro';

const subNavItems = [
  { label: 'Dyktando', href: '/cwiczenia/dyktanda-wysokosciowe', active: true },
  { label: 'Pamięć melodyczna', href: '/cwiczenia/pamiec-melodyczna' },
];
---
<Layout
  title="Dyktanda wysokościowe - ksza.pl"
  description="Ćwiczenie: uzupełnianie wysokości dźwięków w melodii ze słuchu z natychmiastowym feedbackiem nutowym."
  currentFamily="Dyktanda"
  creditType="both"
  includeWidgetsCss={true}
>
  <main>
    <div class="container exercise-page">
      <div class="widget">
        <SubNav items={subNavItems} />
        <div class="widget-header">
          <h1>Dyktando</h1>
          <p>Posłuchaj melodii i dorysuj resztę nut - liczy się tylko to, jak wysoko je postawisz.<br><small>Pierwszy dźwięk jest już poprawny.</small></p>
        </div>

        <div class="controls-row">
          <div class="field">
            <label for="klasa-select">Klasa</label>
            <div class="select-wrap">
              <select id="klasa-select"></select>
            </div>
          </div>
          <div class="field">
            <label for="dictation-select">Dyktando</label>
            <div class="select-wrap">
              <select id="dictation-select"></select>
            </div>
          </div>
          <div class="field">
            <label for="instrument-select">Instrument</label>
            <div class="select-wrap">
              <select id="instrument-select">
                <option value="piano">Fortepian</option>
                <option value="flute">Flet</option>
                <option value="clarinet">Klarnet</option>
                <option value="violin">Skrzypce</option>
                <option value="xylophone">Ksylofon</option>
                <option value="trumpet">Trąbka</option>
                <option value="bassoon">Fagot</option>
              </select>
            </div>
          </div>
          <div class="field tempo-field">
            <label for="tempo-slider">Tempo <span id="tempo-value">100%</span></label>
            <input type="range" id="tempo-slider" min="50" max="150" step="5" value="100">
          </div>
        </div>

        <div id="status-line" class="status-line"></div>

        <div class="player-controls">
          <button id="play-btn" class="btn-primary">
            <span class="play-icon" aria-hidden="true"></span>
            <span>Odtwórz dyktando</span>
          </button>
        </div>

        <div class="notation-wrap">
          <div id="notation-container" class="notation-container" aria-live="polite"></div>
          <div id="gesture-layer" class="gesture-layer" aria-hidden="true"></div>
        </div>
        <p class="gesture-hint">Można też przeciągnąć wybrany dźwięk górę/dół i stuknąć, by zmienić znak.</p>

        <div class="note-builder">
          <div class="note-cursor" role="group" aria-label="Wybór edytowanego dźwięku">
            <button type="button" id="note-prev" class="letter-btn" aria-label="Poprzedni dźwięk">◀</button>
            <span id="note-cursor-label" class="note-cursor-label">Dźwięk 2 z 8</span>
            <button type="button" id="note-next" class="letter-btn" aria-label="Następny dźwięk">▶</button>
          </div>
          <div class="note-builder-controls">
            <div class="note-builder-letter">
              <button type="button" id="letter-down" class="letter-btn" aria-label="Dźwięk niżej">▼</button>
              <button type="button" id="letter-up" class="letter-btn" aria-label="Dźwięk wyżej">▲</button>
            </div>
            <div class="accidental-group" role="group" aria-label="Znak chromatyczny">
              <button type="button" class="accidental-btn" data-alter="-1">♭</button>
              <button type="button" class="accidental-btn is-active" data-alter="0">♮</button>
              <button type="button" class="accidental-btn" data-alter="1">♯</button>
            </div>
          </div>
          <button type="button" id="check-btn" class="btn-primary">Sprawdź</button>
        </div>

        <div id="feedback" class="feedback-msg"></div>
      </div>
    </div>
  </main>

  <Fragment slot="scripts">
    <script is:inline src="/assets/vendor/smplr.js"></script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/verovio@6.2.0/dist/verovio-toolkit-wasm.js"></script>
    <script is:inline src="/assets/js/core.js"></script>
    <script is:inline src="/assets/js/klasa-filter.js"></script>
    <script is:inline src="/assets/js/music-theory.js"></script>
    <script is:inline src="/assets/js/verovio-render.js"></script>
    <script is:inline src="/assets/js/gesture-layer.js"></script>
    <script is:inline src="/assets/js/dyktanda-wysokosciowe.js"></script>
  </Fragment>
</Layout>
