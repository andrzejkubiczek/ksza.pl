---
import NavMenu from '../components/NavMenu.astro';
import Footer from '../components/Footer.astro';
import '@fontsource-variable/manrope';
import '@fontsource-variable/outfit';

export interface Props {
  title: string;
  description?: string;
  currentFamily?: string;
  creditType?: 'none' | 'smplr' | 'verovio' | 'both';
  includeWidgetsCss?: boolean;
  noindex?: boolean;
}

const {
  title,
  description = "Bezpłatne, interaktywne ćwiczenia z kształcenia słuchu: interwały, trójdźwięki, gamy, puzzle, dyktanda i rytm.",
  currentFamily,
  creditType = 'smplr',
  includeWidgetsCss = false,
  noindex = false,
} = Astro.props;

const cleanPath = Astro.url.pathname.replace(/(^|\/)index\.html$/, '$1').replace(/\.html$/, '');
const canonicalUrl = Astro.site ? new URL(cleanPath, Astro.site) : undefined;
---
<!doctype html>
<html lang="pl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="theme-color" content="#f3f4f3">
  <meta name="color-scheme" content="light">
  {noindex && <meta name="robots" content="noindex">}
  {canonicalUrl && <link rel="canonical" href={canonicalUrl}>}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="ksza.pl">
  <meta property="og:locale" content="pl_PL">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  {canonicalUrl && <meta property="og:url" content={canonicalUrl}>}
  <meta name="twitter:card" content="summary">
  <link rel="stylesheet" href="/assets/css/site.css">
  {includeWidgetsCss && <link rel="stylesheet" href="/assets/css/widgets.css">}
</head>
<body>

<header class="site-header">
  <div class="container site-header-inner">
    <a class="brand" href="/">
      <span class="brand-title">ksza.pl<span class="brand-dot" aria-hidden="true"></span></span>
      <small>kształcenie słuchu</small>
    </a>
    <button class="nav-toggle" aria-controls="site-menu" aria-expanded="false" aria-label="Przełącz menu główne">Menu</button>
    <NavMenu currentFamily={currentFamily} />
  </div>
</header>

<slot />

<Footer creditType={creditType} />

<slot name="scripts" />

<script>
  import '../scripts/site.js';
</script>
</body>
</html>
