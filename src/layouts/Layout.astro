---
import NavMenu from '../components/NavMenu.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description?: string;
  currentFamily?: string;
  creditType?: 'none' | 'smplr' | 'verovio' | 'both';
  includeWidgetsCss?: boolean;
}

const {
  title,
  description = "Bezpłatne, interaktywne ćwiczenia z kształcenia słuchu: interwały, trójdźwięki, gamy, puzzle, dyktanda i rytm.",
  currentFamily,
  creditType = 'smplr',
  includeWidgetsCss = false,
} = Astro.props;
---
<!doctype html>
<html lang="pl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/site.css">
  {includeWidgetsCss && <link rel="stylesheet" href="/assets/css/widgets.css">}
</head>
<body>

<header class="site-header">
  <div class="container site-header-inner">
    <a class="brand" href="/">ksza.pl<small>kształcenie słuchu</small></a>
    <button class="nav-toggle" aria-controls="site-menu" aria-expanded="false">Menu</button>
    <NavMenu currentFamily={currentFamily} />
  </div>
</header>

<slot />

<Footer creditType={creditType} />

<slot name="scripts" />
</body>
</html>
