---
export interface Props {
  currentFamily?: string;
}

const { currentFamily } = Astro.props;

const NAV_ITEMS = [
  { label: 'Start', url: '/', family: 'Start' },
  { label: 'Interwały', url: '/cwiczenia/interwaly', family: 'Interwały' },
  { label: 'Trójdźwięki', url: '/cwiczenia/trojdzwieki', family: 'Trójdźwięki' },
  { label: 'Gamy', url: '/cwiczenia/gamy', family: 'Gamy' },
  { label: 'Puzzle', url: '/cwiczenia/puzzle', family: 'Puzzle' },
  { label: 'Dyktanda', url: '/cwiczenia/dyktanda-wysokosciowe', family: 'Dyktanda' },
  { label: 'Rytm', url: '/cwiczenia/rytm', family: 'Rytm' },
  { label: 'O projekcie', url: '/o-projekcie', family: 'O projekcie' },
];
---
<nav class="site-nav" id="site-menu" aria-label="Menu główne">
  <ul>
    {NAV_ITEMS.map((item) => (
      <li>
        <a
          href={item.url}
          aria-current={currentFamily === item.family ? 'page' : undefined}
        >
          {item.label}
        </a>
      </li>
    ))}
  </ul>
</nav>
