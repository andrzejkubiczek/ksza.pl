---
export interface Props {
  creditType?: 'none' | 'smplr' | 'verovio' | 'both';
}

const { creditType = 'smplr' } = Astro.props;
---
<footer class="site-footer">
  <div class="container">
    &copy; <span id="footer-year">2026</span> ksza.pl (aK) &middot; <a href="/o-projekcie">O projekcie</a>
    {(creditType === 'smplr' || creditType === 'both') && (
      <>
        <br /><small>Próbki instrumentów: <a href="https://github.com/danigb/smplr" target="_blank" rel="noopener">smplr</a> (Splendid Grand Piano &middot; Versilian Studios VCSL & VSCO2)</small>
      </>
    )}
    {(creditType === 'verovio' || creditType === 'both') && (
      <>
        <br /><small>Zapis nutowy: silnik <a href="https://www.verovio.org/" target="_blank" rel="noopener">Verovio</a> (RISM Digital Center, licencja LGPL)</small>
      </>
    )}
  </div>
</footer>
